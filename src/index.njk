        <div class="mt-4 md:mt-5 relative h-[1px] bg-line">
          <div class="car-rule absolute left-0 top-0 h-full bg-gold w-8 transition-all duration-700"></div>
        </div>
        <div class="mt-4 md:mt-5 flex items-end justify-between gap-4">
