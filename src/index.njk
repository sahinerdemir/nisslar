      <div>© 2026 nisslar LLC · <span data-i18n="footer.copy">Tüm hakları saklıdır.</span></div>
      <div class="mono-lbl tracking-[0.22em]">MIAMI, FL</div>
    </div>
  </div>
</footer>

<!-- WhatsApp -->
<a id="whatsapp-btn" href="https://wa.me/18635581238" target="_blank" rel="noopener" aria-label="WhatsApp" class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-[#25D366] hover:bg-[#1EBE57] transition rounded-full flex items-center justify-center shadow-lg shadow-black/20">
