function applySiteInfo(content) {
  if (!content?.site) return;
  const s = content.site;
  if (s.email) {
    document.querySelectorAll('#footer-email, #faq-email').forEach(el => {
      el.href = 'mailto:' + s.email;
      if (el.id === 'footer-email') el.textContent = s.email;
    });
  }
  if (s.phone) {
    const el = document.getElementById('footer-phone');
    if (el) { el.href = 'tel:' + s.phone.replace(/[^+\d]/g, ''); el.textContent = s.phone; }
  }
  if (s.whatsapp) {
    const el = document.getElementById('whatsapp-btn');
    if (el) el.href = 'https://wa.me/' + s.whatsapp.replace(/[^0-9]/g, '');
  }
  if (s.socials) {
    const container = document.getElementById('footer-socials');
    container.innerHTML = s.socials.filter(sc => sc.url).map(sc => `
      <a href="${sc.url}" target="_blank" rel="noopener" aria-label="${sc.platform}" class="w-10 h-10 border border-line hover:border-gold hover:text-gold transition flex items-center justify-center text-cream/70">
        ${SOCIAL_ICONS[sc.platform] || ''}
      </a>
    `).join('');
  }
}

function applyContentToI18N(content) {
  if (!content) return;
  const map = {
    hero: {
      eyebrow: 'hero.eyebrow', title1: 'hero.title1', sub: 'hero.sub'
    },
    fleet: {
      title1: 'fleet.title1', title2: 'fleet.title2', title3: 'fleet.title3', desc: 'fleet.desc'
    },
    about: {
      title1: 'about.title1', quote: 'about.quote', p1: 'about.p1'
    },
    trust: {},
    footer: {
      about: 'footer.about'
    }
  };
  for (const [section, fields] of Object.entries(map)) {
    for (const [field, i18nKey] of Object.entries(fields)) {
      const val = content[section]?.[field];
      if (val?.tr) I18N.tr[i18nKey] = val.tr;
      if (val?.en) I18N.en[i18nKey] = val.en;
    }
  }
  if (content.hero?.title2_prefix || content.hero?.title2_gold) {
    const prTr = content.hero.title2_prefix?.tr || 'bir ';
    const glTr = content.hero.title2_gold?.tr || 'deneyim';
    I18N.tr['hero.title2'] = `${prTr}<span class="text-gold not-italic font-normal">${glTr}</span>.`;
    const prEn = content.hero.title2_prefix?.en || 'an ';
    const glEn = content.hero.title2_gold?.en || 'experience';
    I18N.en['hero.title2'] = `${prEn}<span class="text-gold not-italic font-normal">${glEn}</span>.`;
  }
  if (content.about?.title2_prefix || content.about?.title2_gold) {
    const prTr = content.about.title2_prefix?.tr || 'sessiz bir ';
    const glTr = content.about.title2_gold?.tr || 'lüks';
    I18N.tr['about.title2'] = `${prTr}<span class="text-gold not-italic font-normal">${glTr}</span>.`;
    const prEn = content.about.title2_prefix?.en || 'in the heart of ';
    const glEn = content.about.title2_gold?.en || 'Miami';
    I18N.en['about.title2'] = `${prEn}<span class="text-gold not-italic font-normal">${glEn}</span>.`;
  }
  if (content.trust?.items) {
    content.trust.items.forEach((item, i) => {
      const n = i + 1;
      if (item.title?.tr) I18N.tr[`trust.t${n}`] = item.title.tr;
      if (item.title?.en) I18N.en[`trust.t${n}`] = item.title.en;
      if (item.desc?.tr) I18N.tr[`trust.s${n}`] = item.desc.tr;
      if (item.desc?.en) I18N.en[`trust.s${n}`] = item.desc.en;
    });
  }
}

async function loadLiveData() {
  try {
    const [carsRes, faqRes, contentRes] = await Promise.all([
      fetch('/api/cars').then(r => r.ok ? r.json() : null),
      fetch('/api/faq').then(r => r.ok ? r.json() : null),
      fetch('/api/content').then(r => r.ok ? r.json() : null)
    ]);
    if (carsRes) FLEET = carsRes;
    if (faqRes) FAQ = faqRes;
    if (contentRes) {
      applyContentToI18N(contentRes);
      applySiteInfo(contentRes);
      if (contentRes.about?.img) document.getElementById('about-img').src = contentRes.about.img;
    }
    renderMarquee();
    applyI18nContent();
  } catch {}
}

// Theme toggle
const themeToggle = document.getElementById('theme-toggle');
const iconSun = document.getElementById('icon-sun');
const iconMoon = document.getElementById('icon-moon');

function setTheme(mode) {
  if (mode === 'light') {
    document.documentElement.classList.add('light');
    iconSun.classList.add('hidden');
    iconMoon.classList.remove('hidden');
  } else {
    document.documentElement.classList.remove('light');
    iconSun.classList.remove('hidden');
    iconMoon.classList.add('hidden');
  }
  localStorage.setItem('theme', mode);
}

themeToggle.addEventListener('click', () => {
  const isLight = document.documentElement.classList.contains('light');
  setTheme(isLight ? 'dark' : 'light');
});

const savedTheme = localStorage.getItem('theme');
if (savedTheme) setTheme(savedTheme);

renderFleet();
renderMarquee();
renderFAQ();
observeReveals();
loadLiveData();
</script>
