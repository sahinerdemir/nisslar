let LANG = 'tr';

function renderFleet() {
  const t = I18N[LANG];
  const grid = document.getElementById('fleet-grid');
  grid.innerHTML = FLEET.map((c, i) => `
    <article class="car-card group relative border border-line bg-ink2/40 reveal" style="transition-delay:${i*55}ms">
      <div class="relative aspect-[4/3] overflow-hidden">
        ${c.img ? `<img src="${c.img}" alt="${c.name}" class="car-media absolute inset-0 w-full h-full object-cover" />` : `<div class="car-media absolute inset-0 ph"></div>`}
        <div class="absolute left-4 top-4 z-10 mono-lbl text-cream/85">N° ${String(i+1).padStart(3,'0')}</div>
        <div class="absolute left-4 bottom-4 z-10">
          <span class="mono-lbl inline-block px-2.5 py-1 bg-cream text-ink uppercase">${c.cat[LANG]}</span>
        </div>
        <div class="absolute right-4 top-4 z-10 flex items-center gap-1.5">
          <svg viewBox="0 0 24 24" class="w-3 h-3 text-gold" fill="currentColor"><path d="M12 2l2.6 6.3L21 9l-5 4.4L17.3 21 12 17.7 6.7 21 8 13.4 3 9l6.4-.7L12 2z"/></svg>
          <span class="mono-lbl text-cream stat-num">${c.rating.toFixed(2)}</span>
        </div>
        ${!c.img ? `<div class="absolute right-4 bottom-4 z-10 mono-lbl text-cream/30 uppercase">[ ${c.imgLabel} ]</div>` : ''}
      </div>
      <div class="p-5 md:p-6">
        <div class="flex items-baseline justify-between gap-3">
          <h3 class="font-serif text-[20px] md:text-[24px] leading-tight text-cream tracking-tighter2 balance">${c.name}</h3>
          <span class="mono-lbl text-cream/40 stat-num shrink-0">${c.year}</span>
        </div>
        <div class="mt-3 md:mt-4 flex items-center gap-3 mono-lbl text-cream/50 uppercase">
          <span class="stat-num">${c.seats} ${t['card.seats']}</span>
          <span class="text-line2">/</span>
          <span>${c.gear[LANG]}</span>
          <span class="text-line2">/</span>
          <span class="stat-num">${c.hp} ${t['card.hp']}</span>
        </div>
        <div class="mt-4 md:mt-5 relative h-[1px] bg-line">
          <div class="car-rule absolute left-0 top-0 h-full bg-gold w-8 transition-all duration-700"></div>
        </div>
        <div class="mt-4 md:mt-5 flex items-end justify-between gap-4">
          <div>
            ${c.was ? `<div class="mono-lbl text-cream/40 line-through stat-num mb-1">$${c.was} ${t['card.was']}</div>` : `<div class="mono-lbl text-cream/0 mb-1">&middot;</div>`}
            <div class="flex items-baseline gap-1.5">
              <span class="font-serif text-[28px] md:text-[34px] leading-none text-cream stat-num">$${c.price}</span>
              <span class="mono-lbl text-cream/55 uppercase">${t['card.from']}</span>
            </div>
          </div>
          <a href="${c.turoUrl || '#'}" target="_blank" rel="noopener" class="inline-flex items-center gap-2 mono-lbl text-cream uppercase hover:text-gold transition pb-1.5">
            ${t['card.book']}
            <span class="car-cta-arrow inline-block transition-all duration-500">→</span>
          </a>
        </div>
      </div>
    </article>
  `).join('');
  observeReveals();
}

function renderFAQ() {
  const list = document.getElementById('faq-list');
  list.innerHTML = FAQ.map((f, i) => `
    <details class="group py-6 md:py-7" ${i === 0 ? 'open' : ''}>
      <summary class="flex items-start justify-between gap-6 md:gap-8">
        <div class="flex items-baseline gap-4 md:gap-6">
          <span class="mono-lbl text-gold stat-num pt-1.5">${String(i+1).padStart(2,'0')}</span>
          <span class="font-serif text-[18px] md:text-[22px] leading-snug text-cream pretty">${f.q[LANG]}</span>
        </div>
        <span class="acc-bar relative shrink-0 w-7 h-7 mt-1 text-cream/60 group-hover:text-gold transition"></span>
      </summary>
      <div class="acc-body">
        <div>
          <p class="mt-4 pl-[44px] md:pl-[60px] max-w-[640px] text-[13px] md:text-[14.5px] leading-relaxed text-cream/60 pretty">${f.a[LANG]}</p>
        </div>
      </div>
    </details>
  `).join('');
}

function applyI18nContent() {
  const t = I18N[LANG];
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const k = el.getAttribute('data-i18n');
    if (t[k] != null) el.innerHTML = t[k];
  });
  document.documentElement.lang = LANG;
  document.querySelector('.lang-track').setAttribute('data-lang', LANG);
  renderFleet();
  renderFAQ();
}

function switchLang(next) {
  if (next === LANG) return;
  document.body.classList.add('lang-swap');
  setTimeout(() => {
    LANG = next;
    applyI18nContent();
    requestAnimationFrame(() => document.body.classList.remove('lang-swap'));
  }, 260);
}

let io;
function observeReveals() {
  if (!io) {
    io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.10, rootMargin: '0px 0px -40px 0px' });
  }
  document.querySelectorAll('.reveal:not(.in)').forEach(el => io.observe(el));
}

// Lang switch
document.querySelectorAll('.lang-pill').forEach(p => {
  p.addEventListener('click', () => switchLang(p.dataset.lang));
});

// Hamburger
const hamburger = document.querySelector('.hamburger');
const mobileMenu = document.querySelector('.mobile-menu');
hamburger.addEventListener('click', () => {
  hamburger.classList.toggle('active');
  mobileMenu.classList.toggle('open');
  document.body.style.overflow = mobileMenu.classList.contains('open') ? 'hidden' : '';
});
document.querySelectorAll('.mobile-link').forEach(link => {
  link.addEventListener('click', () => {
    hamburger.classList.remove('active');
    mobileMenu.classList.remove('open');
    document.body.style.overflow = '';
  });
});

renderFleet();
renderFAQ();
observeReveals();
</script>
