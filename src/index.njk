let LANG = 'tr';

function renderMarquee() {
  const track = document.getElementById('marquee-track');
  const names = FLEET.map(c => c.name.toLocaleUpperCase('en-US'));
  const items = names.map(n => `<span>${n}</span><span class="text-gold/50">◆</span>`).join('');
  track.innerHTML = items + items;
}

