      <div class="mono-lbl text-gold uppercase mb-4">— <span data-i18n="faq.eyebrow">Sıkça Sorulanlar</span> · N° 03</div>
      <h2 class="font-serif text-[clamp(36px,4.6vw,68px)] leading-[0.96] tracking-tightest text-cream balance">
        <span data-i18n="faq.title1">Önce</span><br/>
        <span class="italic font-light text-gold" data-i18n="faq.title2">cevaplar</span>.
