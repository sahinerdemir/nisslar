<!-- SCRIPTS -->
<script>
let FLEET = {{ cars | dump | safe }};
let FAQ = {{ faq | dump | safe }};

const I18N = {
  tr: {
    'nav.home':'Ana Sayfa','nav.fleet':'Filo','nav.about':'Hakkımızda','nav.faq':'SSS','nav.book':'Rezerve Et',
    'hero.eyebrow':'Miami · Lüks Filo','hero.title1':'Sürüş değil,',
    'hero.title2':'bir <span class="text-gold not-italic font-normal">deneyim</span>.',
    'hero.sub':'Miami sokaklarında, özenle seçilmiş bir filo. Sigorta dahil, gizli ücret yok — yalnız siz, anahtarlar ve yol.',
    'hero.cta1':'Araçları Gör','hero.cta2':'Rezerve Et',
    'hero.meta1':'Filo','hero.meta2':'Kuruluş','hero.meta3':'Puan',
    'trust.eyebrow':'— Söz','trust.lead':'Üç söz veriyoruz, üçünü de tutuyoruz.',
