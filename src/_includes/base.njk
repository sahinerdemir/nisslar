<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>{{ title or "NISSLAR — Miami Lüks Araç Kiralama" }}</title>
<link rel="icon" type="image/png" href="/assets/favicon.png" />
<script src="https://cdn.tailwindcss.com"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@300;400;500&display=swap" rel="stylesheet">
<script>
  tailwind.config = {
    theme: {
      extend: {
        colors: {
          ink: '#FFFFFF', ink2: '#F7F8FA', ink3: '#EEF1F5',
          line: '#E2E8F0', line2: '#CBD5E1',
          cream: '#1E293B', cream2: '#334155',
          gold: '#3B82F6', goldhi: '#2563EB', golddim: '#60A5FA',
          accent: '#F97316', accenthi: '#EA580C',
          muted: '#64748B',
        },
        fontFamily: {
          serif: ['Playfair Display', 'ui-serif', 'Georgia', 'serif'],
          sans: ['Inter', 'ui-sans-serif', 'system-ui', 'sans-serif'],
          mono: ['"JetBrains Mono"', 'ui-monospace', 'monospace'],
        },
        letterSpacing: { tightest: '-0.045em', tighter2: '-0.03em' },
      }
    }
  }
</script>
<style>
  :root { color-scheme: light; }
  html { scroll-behavior: smooth; overflow-x: hidden; }
  html, body { background: #FFFFFF; color: #1E293B; }
  body { overflow-x: hidden; }
  body { font-family: 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
  .font-serif { font-family: 'Playfair Display', Georgia, serif; }
  section[id], #faq, #fleet, #about { scroll-margin-top: 88px; }
  .hero-overlay { background: rgba(22,19,15,0.2); }

  body::before, body::after { content: ""; position: fixed; border-radius: 50%; pointer-events: none; z-index: -1; filter: blur(120px); opacity: 0.4; }
  body::before { width: 600px; height: 600px; top: -100px; left: -150px; background: radial-gradient(circle, rgba(59,130,246,0.10) 0%, transparent 70%); }
  body::after { width: 500px; height: 500px; bottom: 10%; right: -100px; background: radial-gradient(circle, rgba(249,115,22,0.08) 0%, transparent 70%); }

  #fleet::before { content: ""; position: absolute; top: 20%; right: 5%; width: 400px; height: 400px; border-radius: 50%; background: radial-gradient(circle, rgba(59,130,246,0.06) 0%, transparent 70%); filter: blur(80px); pointer-events: none; z-index: 0; }
  #about::after { content: ""; position: absolute; bottom: 10%; left: 5%; width: 350px; height: 350px; border-radius: 50%; background: radial-gradient(circle, rgba(249,115,22,0.05) 0%, transparent 70%); filter: blur(80px); pointer-events: none; z-index: 0; }

  .reveal { opacity: 0; transform: translateY(20px); transition: opacity 1s cubic-bezier(.2,.7,.2,1), transform 1s cubic-bezier(.2,.7,.2,1); }
  .reveal.in { opacity: 1; transform: none; }
  .ph { background: repeating-linear-gradient(110deg, rgba(30,41,59,0.04) 0 1px, transparent 1px 14px), radial-gradient(120% 80% at 30% 25%, #EEF1F5 0%, #F7F8FA 55%, #FFFFFF 100%); }
  .car-card { transition: transform .55s cubic-bezier(.2,.7,.2,1), border-color .4s; }
  .car-card:hover { transform: translateY(-4px) scale(1.012); border-color: rgba(59,130,246,0.5); }
  .car-media { transition: transform 1.3s cubic-bezier(.2,.7,.2,1); }
  .car-card:hover .car-media { transform: scale(1.065); }
  .car-card:hover .car-cta-arrow { transform: translateX(6px); color: #FFFFFF; }
  .car-card:hover .car-rule { width: 100%; }
  .lnk { position: relative; }
  .lnk::after { content: ""; position: absolute; left: 0; right: 0; bottom: -3px; height: 1px; background: currentColor; transform: scaleX(0); transform-origin: left; transition: transform .45s cubic-bezier(.2,.7,.2,1); }
  .lnk:hover::after { transform: scaleX(1); }
  .rule-accent { height: 1px; background: linear-gradient(90deg, transparent, #F97316 30%, #F97316 70%, transparent); }
  details > summary { list-style: none; cursor: pointer; }
  details > summary::-webkit-details-marker { display: none; }
  details[open] .acc-plus { display: none; }
  details[open] .acc-minus { display: block; }
  details:not([open]) .acc-plus { display: block; }
  details:not([open]) .acc-minus { display: none; }
  details .acc-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .5s cubic-bezier(.2,.7,.2,1); }
  details[open] .acc-body { grid-template-rows: 1fr; }
  details .acc-body > div { overflow: hidden; }
  .stat-num { font-variant-numeric: tabular-nums; }
  .lang-track { position: relative; }
  .lang-slider { position: absolute; top: 4px; bottom: 4px; left: 4px; width: calc(50% - 4px); background: #3B82F6; border-radius: 999px; transition: transform .45s cubic-bezier(.4,.6,.2,1.1); }
  .lang-track[data-lang="en"] .lang-slider { transform: translateX(100%); }
  .lang-pill { position: relative; z-index: 1; transition: color .35s; }
  .lang-track[data-lang="tr"] .lang-pill[data-lang="tr"] { color: #FFFFFF; }
  .lang-track[data-lang="tr"] .lang-pill[data-lang="en"] { color: #64748B; }
  .lang-track[data-lang="en"] .lang-pill[data-lang="en"] { color: #FFFFFF; }
  .lang-track[data-lang="en"] .lang-pill[data-lang="tr"] { color: #64748B; }
  [data-i18n] { transition: opacity .25s ease, filter .25s ease, transform .25s ease; }
  body.lang-swap [data-i18n] { opacity: 0; filter: blur(4px); transform: translateY(-3px); }
  .marquee { display: flex; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .marquee-track { display: flex; gap: 4rem; animation: scroll 40s linear infinite; flex-shrink: 0; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  .mono-lbl { font-family: 'JetBrains Mono', monospace; font-size: 10.5px; letter-spacing: 0.16em; }
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: #F7F8FA; }
  ::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 99px; }
  ::-webkit-scrollbar-thumb:hover { background: #94A3B8; }
  .balance { text-wrap: balance; }
  .pretty { text-wrap: pretty; }
  .arr { display: inline-block; transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .group:hover .arr, a:hover .arr { transform: translateX(4px); }
  ::selection { background: #3B82F6; color: #FFFFFF; }

  .mobile-menu { transform: translateX(100%); transition: transform .4s cubic-bezier(.2,.7,.2,1); }
  .mobile-menu.open { transform: translateX(0); }
  .hamburger span { transition: all .3s; }
  .hamburger.active span:nth-child(1) { transform: rotate(45deg) translate(5px, 5px); }
  .hamburger.active span:nth-child(2) { opacity: 0; }
  .hamburger.active span:nth-child(3) { transform: rotate(-45deg) translate(5px, -5px); }
</style>
</head>
<body class="font-sans">
{{ content | safe }}

<!-- Contact Modal -->
<div id="contact-modal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
  <div class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-300 opacity-0" id="contact-modal-overlay"></div>
  <div class="relative bg-white text-cream max-w-md w-full border border-line p-6 md:p-8 transform scale-95 opacity-0 transition-all duration-300 z-10 shadow-2xl flex flex-col gap-6" id="contact-modal-box">
    <!-- Header -->
    <div class="flex items-start justify-between">
      <div>
        <div class="mono-lbl text-accent uppercase mb-1.5">— CONTACT / İLETİŞİM</div>
        <h3 class="font-serif text-[24px] md:text-[28px] leading-tight text-cream" data-i18n="modal.title">Rezerve Et</h3>
      </div>
      <button id="contact-modal-close" class="text-cream/40 hover:text-cream text-2xl transition" aria-label="Kapat">&times;</button>
    </div>

    <!-- Body -->
    <p class="text-[14px] md:text-[15px] leading-relaxed text-cream/70 pretty" data-i18n="modal.desc">
      Bizimle iletişime geçmek için aşağıdaki iletişim yollarını kullanabilirsiniz.
    </p>

    <!-- Details -->
    <div class="flex flex-col gap-3">
      <!-- Phone -->
      <a id="modal-phone" href="tel:{{ siteContent.site.phone }}" class="flex items-center gap-4 p-4 border border-line hover:border-gold/50 bg-ink2/30 hover:bg-gold/5 transition group">
        <div class="w-10 h-10 bg-gold/10 text-gold flex items-center justify-center rounded-full shrink-0 group-hover:scale-105 transition duration-300">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="mono-lbl text-[10px] text-cream/40 uppercase" data-i18n="modal.phone">Telefon Numarası</span>
          <span id="modal-phone-text" class="font-serif text-[17px] text-cream tracking-tight">{{ siteContent.site.phone }}</span>
        </div>
      </a>

      <!-- Email -->
      <a id="modal-email" href="mailto:{{ siteContent.site.email }}" class="flex items-center gap-4 p-4 border border-line hover:border-gold/50 bg-ink2/30 hover:bg-gold/5 transition group">
        <div class="w-10 h-10 bg-gold/10 text-gold flex items-center justify-center rounded-full shrink-0 group-hover:scale-105 transition duration-300">
          <svg viewBox="0 0 24 24" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="mono-lbl text-[10px] text-cream/40 uppercase" data-i18n="modal.email">E-posta Adresi</span>
          <span id="modal-email-text" class="font-serif text-[17px] text-cream tracking-tight">{{ siteContent.site.email }}</span>
        </div>
      </a>
    </div>
  </div>
</div>

<script>
window.openReserveModal = function(event) {
  if (event) {
    event.preventDefault();
    event.stopPropagation();
  }
  
  // Sync details from footer dynamically
  const footerPhone = document.getElementById('footer-phone');
  const footerEmail = document.getElementById('footer-email');
  const modalPhone = document.getElementById('modal-phone');
  const modalPhoneText = document.getElementById('modal-phone-text');
  const modalEmail = document.getElementById('modal-email');
  const modalEmailText = document.getElementById('modal-email-text');
  
  if (footerPhone && modalPhone && modalPhoneText) {
    modalPhone.href = footerPhone.href;
    modalPhoneText.textContent = footerPhone.textContent.trim();
  }
  if (footerEmail && modalEmail && modalEmailText) {
    modalEmail.href = footerEmail.href;
    modalEmailText.textContent = footerEmail.textContent.trim();
  }

  const modal = document.getElementById('contact-modal');
  const overlay = document.getElementById('contact-modal-overlay');
  const box = document.getElementById('contact-modal-box');
  if (!modal) return;
  
  modal.classList.remove('hidden');
  modal.classList.add('flex');
  document.body.style.overflow = 'hidden';
  
  setTimeout(() => {
    overlay.classList.remove('opacity-0');
    overlay.classList.add('opacity-100');
    box.classList.remove('scale-95', 'opacity-0');
    box.classList.add('scale-100', 'opacity-100');
  }, 10);
};

window.closeReserveModal = function() {
  const modal = document.getElementById('contact-modal');
  const overlay = document.getElementById('contact-modal-overlay');
  const box = document.getElementById('contact-modal-box');
  if (!modal) return;
  
  overlay.classList.remove('opacity-100');
  overlay.classList.add('opacity-0');
  box.classList.remove('scale-100', 'opacity-100');
  box.classList.add('scale-95', 'opacity-0');
  
  setTimeout(() => {
    modal.classList.remove('flex');
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  }, 300);
};

document.addEventListener('DOMContentLoaded', () => {
  const overlay = document.getElementById('contact-modal-overlay');
  const closeBtn = document.getElementById('contact-modal-close');
  if (overlay) overlay.addEventListener('click', window.closeReserveModal);
  if (closeBtn) closeBtn.addEventListener('click', window.closeReserveModal);
});
</script>
</body>
</html>
