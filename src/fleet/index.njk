<script>
let FLEET = {{ cars | dump | safe }};
const PER_PAGE = 12;
let currentPage = 1;
let LANG = 'tr';

const I18N = {
  tr: {
    'nav.home':'Ana Sayfa','nav.fleet':'Araçlar','nav.about':'Hakkımızda','nav.faq':'SSS','nav.book':'Rezerve Et',
    'fleet.eyebrow':'Filo','fleet.title1':'Size özel','fleet.title2':'araçlar',
    'fleet.desc':'Her araç bizzat seçildi. Detaylı temizlik, tam yakıt, anahtar elden teslim — başka türlüsü olmaz.',
    'fleet.filter':'Filtre','fleet.sort':'Sırala',
    'fleet.allBrands':'Tüm Markalar','fleet.allCats':'Tüm Kategoriler','fleet.allSeats':'Tüm Koltuklar',
    'fleet.sortDefault':'Varsayılan','fleet.sortName':'İsim (A-Z)',
    'fleet.sortYear':'Yıl (Yeni → Eski)','fleet.sortHp':'Güç (Yüksek → Düşük)',
    'fleet.sortSeats':'Koltuk (Az → Çok)',
    'fleet.empty':'Bu kriterlere uygun araç bulunamadı.',
    'fleet.showing':'{count} araç gösteriliyor',
    'card.book':'Rezerve Et','card.seats':'koltuk','card.hp':'BG',
    'modal.title':'Rezerve Et','modal.desc':'Bizimle iletişime geçmek için aşağıdaki iletişim yollarını kullanabilirsiniz.','modal.phone':'Telefon Numarası','modal.email':'E-posta Adresi',
    'footer.eyebrow':'— RENT. DRIVE. EXPERIENCE.',
    'footer.about':"Miami merkezli, butik lüks araç kiralama. 2018'den beri özenle.",
    'footer.h1':'İletişim','footer.h3':'Hızlı Linkler',
    'footer.copy':'Tüm hakları saklıdır.',
  },
  en: {
    'nav.home':'Home','nav.fleet':'Fleet','nav.about':'About','nav.faq':'FAQ','nav.book':'Reserve',
    'fleet.eyebrow':'Fleet','fleet.title1':'Cars curated','fleet.title2':'for you',
    'fleet.desc':'Each car personally selected. Detailed clean, full fuel, handover in person — no other way.',
    'fleet.filter':'Filter','fleet.sort':'Sort',
    'fleet.allBrands':'All Brands','fleet.allCats':'All Categories','fleet.allSeats':'All Seats',
    'fleet.sortDefault':'Default','fleet.sortName':'Name (A-Z)',
    'fleet.sortYear':'Year (New → Old)','fleet.sortHp':'Power (High → Low)',
    'fleet.sortSeats':'Seats (Low → High)',
    'fleet.empty':'No cars match these criteria.',
    'fleet.showing':'{count} cars shown',
    'card.book':'Reserve','card.seats':'seats','card.hp':'HP',
    'modal.title':'Reserve','modal.desc':'You can use the contact methods below to reach us.','modal.phone':'Phone Number','modal.email':'Email Address',
    'footer.eyebrow':'— RENT. DRIVE. EXPERIENCE.',
    'footer.about':'Miami-based, boutique luxury car rental. Carefully, since 2018.',
    'footer.h1':'Contact','footer.h3':'Quick Links',
    'footer.copy':'All rights reserved.',
  }
};

function getFilteredSorted() {
  let cars = [...FLEET];
  const brand = document.getElementById('filter-brand').value;
  const cat = document.getElementById('filter-cat').value;
  const seats = document.getElementById('filter-seats').value;
  const sort = document.getElementById('sort-by').value;

  if (brand !== 'all') cars = cars.filter(c => c.brand === brand);
  if (cat !== 'all') cars = cars.filter(c => c.cat[LANG] === cat);
  if (seats !== 'all') cars = cars.filter(c => c.seats === parseInt(seats));

  switch (sort) {
    case 'name': cars.sort((a, b) => a.name.localeCompare(b.name)); break;
    case 'year-desc': cars.sort((a, b) => b.year - a.year); break;
    case 'hp-desc': cars.sort((a, b) => b.hp - a.hp); break;
    case 'seats-asc': cars.sort((a, b) => a.seats - b.seats); break;
  }
  return cars;
}

function populateFilters() {
  const t = I18N[LANG];
  const brandSelect = document.getElementById('filter-brand');
  const catSelect = document.getElementById('filter-cat');
  const seatsSelect = document.getElementById('filter-seats');
  const sortSelect = document.getElementById('sort-by');

  const brands = [...new Set(FLEET.map(c => c.brand))].sort();
  const cats = [...new Set(FLEET.map(c => c.cat[LANG]))].sort();
  const seatVals = [...new Set(FLEET.map(c => c.seats))].sort((a, b) => a - b);

  const prevBrand = brandSelect.value;
  const prevCat = catSelect.value;
  const prevSeats = seatsSelect.value;

  brandSelect.innerHTML = `<option value="all">${t['fleet.allBrands']}</option>` +
    brands.map(b => `<option value="${b}" ${b === prevBrand ? 'selected' : ''}>${b}</option>`).join('');

  catSelect.innerHTML = `<option value="all">${t['fleet.allCats']}</option>` +
    cats.map(c => `<option value="${c}" ${c === prevCat ? 'selected' : ''}>${c}</option>`).join('');

  seatsSelect.innerHTML = `<option value="all">${t['fleet.allSeats']}</option>` +
    seatVals.map(s => `<option value="${s}" ${String(s) === prevSeats ? 'selected' : ''}>${s} ${t['card.seats']}</option>`).join('');

  sortSelect.querySelectorAll('option').forEach(opt => {
    const key = opt.getAttribute('data-i18n-opt');
    if (key && t[key]) opt.textContent = t[key];
  });
}

function renderFleet() {
  const t = I18N[LANG];
  const cars = getFilteredSorted();
  const totalPages = Math.max(1, Math.ceil(cars.length / PER_PAGE));
  if (currentPage > totalPages) currentPage = totalPages;

  const start = (currentPage - 1) * PER_PAGE;
  const pageCars = cars.slice(start, start + PER_PAGE);

  const grid = document.getElementById('fleet-grid');
  const empty = document.getElementById('fleet-empty');
  const count = document.getElementById('fleet-count');

  count.textContent = t['fleet.showing'].replace('{count}', cars.length);

  if (pageCars.length === 0) {
    grid.innerHTML = '';
    empty.classList.remove('hidden');
  } else {
    empty.classList.add('hidden');
    grid.innerHTML = pageCars.map((c, i) => `
      <article class="car-card group relative border border-line bg-white reveal" style="transition-delay:${i*55}ms">
        <a href="/fleet/detail/?id=${c.id}" class="block relative aspect-[4/3] overflow-hidden">
          ${c.img ? `<img src="${c.img}" alt="${c.name}" class="car-media absolute inset-0 w-full h-full object-cover" />` : `<div class="car-media absolute inset-0 ph"></div>`}
          <div class="absolute left-4 bottom-4 z-10 flex items-center gap-2">
            <span class="mono-lbl inline-block px-3 py-1 bg-emerald-600 text-white rounded-full">${c.cat[LANG].toLocaleUpperCase(LANG === 'tr' ? 'tr-TR' : 'en-US')}</span>
            <span class="mono-lbl inline-block px-3 py-1 bg-accent text-white rounded-full">${c.year}</span>
          </div>
        </a>
        <div class="p-5 md:p-6">
          <div class="flex items-baseline justify-between gap-3">
            <a href="/fleet/detail/?id=${c.id}" class="font-serif text-[20px] md:text-[24px] leading-tight text-cream tracking-tighter2 balance hover:text-accent transition">${c.name}</a>
          </div>
          <div class="mt-3 md:mt-4 flex items-center gap-3 mono-lbl text-cream/50">
            <span class="stat-num">${c.seats} ${t['card.seats'].toLocaleUpperCase(LANG)}</span>
            <span class="text-line2">/</span>
            <span>${c.gear[LANG].toLocaleUpperCase('en-US')}</span>
            <span class="text-line2">/</span>
            <span class="stat-num">${c.hp} ${t['card.hp'].toLocaleUpperCase(LANG)}</span>
          </div>
          <div class="mt-4 md:mt-5 relative h-[1px] bg-line">
            <div class="car-rule absolute left-0 top-0 h-full bg-accent w-8 transition-all duration-700"></div>
          </div>
          <a href="${(c.turoUrl && c.turoUrl !== '#') ? c.turoUrl : '#'}" 
             ${(c.turoUrl && c.turoUrl !== '#') ? 'target="_blank" rel="noopener"' : 'onclick="openReserveModal(event)"'} 
             class="mt-5 w-full bg-gold text-white hover:bg-goldhi transition py-3 rounded-full text-center text-[11px] font-semibold tracking-[0.18em] uppercase flex items-center justify-center gap-2">
            <span>${t['card.book'].toLocaleUpperCase(LANG === 'tr' ? 'tr-TR' : 'en-US')}</span>
            <span class="arr">→</span>
          </a>
        </div>
      </article>
    `).join('');
  }

  renderPagination(totalPages);
  observeReveals();
}

function renderPagination(totalPages) {
  const pag = document.getElementById('pagination');
  if (totalPages <= 1) { pag.innerHTML = ''; return; }

  let html = '';
  const btnClass = 'w-10 h-10 flex items-center justify-center rounded-lg text-[13px] font-medium transition';
  const activeClass = 'bg-gold text-white';
  const inactiveClass = 'bg-white border border-line text-cream/70 hover:border-gold hover:text-gold';

  if (currentPage > 1) {
    html += `<button class="${btnClass} ${inactiveClass}" data-page="${currentPage - 1}">←</button>`;
  }

  for (let i = 1; i <= totalPages; i++) {
    if (totalPages > 7 && i > 2 && i < totalPages - 1 && Math.abs(i - currentPage) > 1) {
      if (html.slice(-3) !== '...') html += `<span class="w-8 text-center text-cream/30">...</span>`;
      continue;
    }
    html += `<button class="${btnClass} ${i === currentPage ? activeClass : inactiveClass}" data-page="${i}">${i}</button>`;
  }

  if (currentPage < totalPages) {
    html += `<button class="${btnClass} ${inactiveClass}" data-page="${currentPage + 1}">→</button>`;
  }

  pag.innerHTML = html;
  pag.querySelectorAll('button[data-page]').forEach(btn => {
    btn.addEventListener('click', () => {
      currentPage = parseInt(btn.dataset.page);
      renderFleet();
      window.scrollTo({ top: document.getElementById('fleet-grid').offsetTop - 120, behavior: 'smooth' });
    });
  });
}

let io;
function observeReveals() {
  if (!io) {
    io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.10, rootMargin: '0px 0px -40px 0px' });
  }
  document.querySelectorAll('.reveal:not(.in)').forEach(el => io.observe(el));
}

function applyI18nContent() {
  const t = I18N[LANG];
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const k = el.getAttribute('data-i18n');
    if (t[k] != null) el.innerHTML = t[k];
  });
  document.documentElement.lang = LANG;
  document.querySelector('.lang-track').setAttribute('data-lang', LANG);
  populateFilters();
  renderFleet();
}

function switchLang(next) {
  if (next === LANG) return;
  document.body.classList.add('lang-swap');
  setTimeout(() => {
    LANG = next;
    applyI18nContent();
    requestAnimationFrame(() => document.body.classList.remove('lang-swap'));
  }, 260);
}

document.querySelectorAll('.lang-pill').forEach(p => {
  p.addEventListener('click', () => switchLang(p.dataset.lang));
});

document.getElementById('filter-brand').addEventListener('change', () => { currentPage = 1; renderFleet(); });
document.getElementById('filter-cat').addEventListener('change', () => { currentPage = 1; renderFleet(); });
document.getElementById('filter-seats').addEventListener('change', () => { currentPage = 1; renderFleet(); });
document.getElementById('sort-by').addEventListener('change', () => { currentPage = 1; renderFleet(); });

const hamburger = document.querySelector('.hamburger');
const mobileMenu = document.querySelector('.mobile-menu');
hamburger.addEventListener('click', () => {
  hamburger.classList.toggle('active');
  mobileMenu.classList.toggle('open');
  document.body.style.overflow = mobileMenu.classList.contains('open') ? 'hidden' : '';
});
document.querySelectorAll('.mobile-link').forEach(link => {
  link.addEventListener('click', () => {
    hamburger.classList.remove('active');
    mobileMenu.classList.remove('open');
    document.body.style.overflow = '';
  });
});

