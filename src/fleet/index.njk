function applySiteInfo(content) {
  if (!content?.site) return;
  const s = content.site;
  if (s.email) {
    const el = document.getElementById('footer-email');
    if (el) { el.href = 'mailto:' + s.email; el.textContent = s.email; }
  }
  if (s.phone) {
    const el = document.getElementById('footer-phone');
    if (el) { el.href = 'tel:' + s.phone.replace(/[^+\d]/g, ''); el.textContent = s.phone; }
  }
  if (s.whatsapp) {
    const el = document.getElementById('whatsapp-btn');
    if (el) el.href = 'https://wa.me/' + s.whatsapp.replace(/[^0-9]/g, '');
  }
  if (s.socials) {
    const container = document.getElementById('footer-socials');
    if (container) container.innerHTML = s.socials.filter(sc => sc.url).map(sc => `
      <a href="${sc.url}" target="_blank" rel="noopener" aria-label="${sc.platform}" class="w-10 h-10 border border-white/10 hover:border-accent hover:text-accent transition flex items-center justify-center text-white/70">
        ${SOCIAL_ICONS[sc.platform] || ''}
      </a>
    `).join('');
  }
}

async function loadLiveData() {
  try {
    const [carsRes, contentRes] = await Promise.all([
      fetch('/api/cars').then(r => r.ok ? r.json() : null),
      fetch('/api/content').then(r => r.ok ? r.json() : null)
    ]);
    if (carsRes && carsRes.length > 0) {
      const cmsIds = new Set(carsRes.map(c => c.id));
      const localOnly = FLEET.filter(c => !cmsIds.has(c.id));
      FLEET = [...carsRes, ...localOnly];
    }
    if (contentRes) applySiteInfo(contentRes);
    populateFilters();
    renderFleet();
  } catch {}
}

populateFilters();
renderFleet();
observeReveals();
loadLiveData();
</script>
