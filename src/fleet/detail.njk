<script>
let FLEET = {{ cars | dump | safe }};
let LANG = 'tr';

const I18N = {
  tr: {
    'nav.home':'Ana Sayfa','nav.fleet':'Filo','nav.about':'Hakkımızda','nav.faq':'SSS','nav.book':'Rezerve Et',
    'detail.seats':'Koltuk','detail.gas':'Yakıt','detail.gear':'Vites',
    'detail.features':'Araç Özellikleri','detail.reserve':'Rezerve Et','detail.back':'Filoya Dön',
    'footer.eyebrow':'— RENT. DRIVE. EXPERIENCE.',
    'footer.about':"Miami merkezli, butik lüks araç kiralama. 2018'den beri özenle.",
    'footer.h1':'İletişim','footer.h3':'Hızlı Linkler','footer.copy':'Tüm hakları saklıdır.',
  },
  en: {
    'nav.home':'Home','nav.fleet':'Fleet','nav.about':'About','nav.faq':'FAQ','nav.book':'Reserve',
    'detail.seats':'Seats','detail.gas':'Fuel','detail.gear':'Transmission',
    'detail.features':'Vehicle Features','detail.reserve':'Reserve Now','detail.back':'Back to Fleet',
    'footer.eyebrow':'— RENT. DRIVE. EXPERIENCE.',
    'footer.about':'Miami-based, boutique luxury car rental. Carefully, since 2018.',
    'footer.h1':'Contact','footer.h3':'Quick Links','footer.copy':'All rights reserved.',
  }
};

let galleryIndex = 0;
let galleryImages = [];

function initGallery(images) {
  galleryImages = images.length > 0 ? images : [];
  if (galleryImages.length === 0) {
    document.getElementById('gallery-track').innerHTML = '<div class="w-full h-full shrink-0 ph"></div>';
    document.getElementById('gallery-prev').classList.add('hidden');
    document.getElementById('gallery-next').classList.add('hidden');
    document.getElementById('gallery-dots').innerHTML = '';
    document.getElementById('gallery-counter').classList.add('hidden');
    document.getElementById('gallery-thumbs').innerHTML = '';
    return;
  }

  const track = document.getElementById('gallery-track');
  track.innerHTML = galleryImages.map(src =>
    `<div class="w-full h-full shrink-0"><img src="${src}" alt="" class="w-full h-full object-cover"/></div>`
  ).join('');

  const dots = document.getElementById('gallery-dots');
  dots.innerHTML = galleryImages.map((_, i) =>
    `<button class="gallery-dot w-2.5 h-2.5 rounded-full transition ${i === 0 ? 'bg-white' : 'bg-white/40'}" data-i="${i}"></button>`
  ).join('');
  dots.querySelectorAll('.gallery-dot').forEach(d => d.addEventListener('click', () => goToSlide(parseInt(d.dataset.i))));

  const thumbs = document.getElementById('gallery-thumbs');
  thumbs.innerHTML = galleryImages.map((src, i) =>
    `<button class="gallery-thumb shrink-0 w-16 h-12 md:w-20 md:h-14 rounded-lg overflow-hidden border-2 transition ${i === 0 ? 'border-gold' : 'border-transparent opacity-60'}" data-i="${i}">
      <img src="${src}" alt="" class="w-full h-full object-cover"/>
    </button>`
  ).join('');
  thumbs.querySelectorAll('.gallery-thumb').forEach(t => t.addEventListener('click', () => goToSlide(parseInt(t.dataset.i))));

  if (galleryImages.length <= 1) {
    document.getElementById('gallery-prev').classList.add('hidden');
    document.getElementById('gallery-next').classList.add('hidden');
    dots.classList.add('hidden');
  }

  updateGallery();

  let touchStartX = 0;
  const gallery = document.getElementById('gallery');
  gallery.addEventListener('touchstart', e => { touchStartX = e.touches[0].clientX; }, { passive: true });
  gallery.addEventListener('touchend', e => {
    const diff = touchStartX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) {
      if (diff > 0 && galleryIndex < galleryImages.length - 1) goToSlide(galleryIndex + 1);
      else if (diff < 0 && galleryIndex > 0) goToSlide(galleryIndex - 1);
    }
  }, { passive: true });
}

function goToSlide(i) {
  galleryIndex = i;
  updateGallery();
}

function updateGallery() {
  const track = document.getElementById('gallery-track');
  track.style.transform = `translateX(-${galleryIndex * 100}%)`;
  document.getElementById('gallery-counter').textContent = `${galleryIndex + 1} / ${galleryImages.length}`;

  document.querySelectorAll('.gallery-dot').forEach((d, i) => {
    d.classList.toggle('bg-white', i === galleryIndex);
    d.classList.toggle('bg-white/40', i !== galleryIndex);
  });
  document.querySelectorAll('.gallery-thumb').forEach((t, i) => {
    t.classList.toggle('border-gold', i === galleryIndex);
    t.classList.toggle('border-transparent', i !== galleryIndex);
    t.classList.toggle('opacity-60', i !== galleryIndex);
  });
}

document.getElementById('gallery-prev').addEventListener('click', () => {
  if (galleryIndex > 0) goToSlide(galleryIndex - 1);
});
document.getElementById('gallery-next').addEventListener('click', () => {
  if (galleryIndex < galleryImages.length - 1) goToSlide(galleryIndex + 1);
});

function renderDetail(car) {
  const t = I18N[LANG];
  document.title = `${car.name} — NISSLAR`;
  document.getElementById('bc-name').textContent = car.name;
  document.getElementById('detail-name').textContent = car.name;
  document.getElementById('detail-brand').textContent = car.brand || '';
  document.getElementById('detail-cat').textContent = car.cat[LANG].toLocaleUpperCase(LANG === 'tr' ? 'tr-TR' : 'en-US');
  document.getElementById('detail-year').textContent = car.year;
  document.getElementById('spec-hp').textContent = car.hp;
  document.getElementById('spec-seats').textContent = car.seats;
  document.getElementById('spec-gas').textContent = car.gas || 'Premium';
  document.getElementById('spec-mpg').textContent = car.mpg || '—';
  document.getElementById('spec-gear').textContent = car.gear[LANG];
  document.getElementById('cta-turo').href = car.turoUrl || '#';

  const featGrid = document.getElementById('features-grid');
  const features = car.features || [];
  featGrid.innerHTML = features.map(f =>
    `<div class="flex items-center gap-2.5 py-1.5">
      <svg viewBox="0 0 16 16" class="w-4 h-4 text-accent shrink-0" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8l3.5 3.5L13 5"/></svg>
      <span class="text-[14px] text-cream/75">${f}</span>
    </div>`
  ).join('');

  const images = (car.gallery && car.gallery.length > 0) ? car.gallery.filter(g => g) : (car.img ? [car.img] : []);
  initGallery(images);

  document.getElementById('detail-loading').classList.add('hidden');
  document.getElementById('detail-content').classList.remove('hidden');
}

function applyI18nContent() {
  const t = I18N[LANG];
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const k = el.getAttribute('data-i18n');
    if (t[k] != null) el.innerHTML = t[k];
  });
  document.documentElement.lang = LANG;
  document.querySelector('.lang-track').setAttribute('data-lang', LANG);
  const carId = new URLSearchParams(window.location.search).get('id');
  const car = FLEET.find(c => c.id === carId);
  if (car) renderDetail(car);
}

function switchLang(next) {
  if (next === LANG) return;
  document.body.classList.add('lang-swap');
  setTimeout(() => {
    LANG = next;
    applyI18nContent();
    requestAnimationFrame(() => document.body.classList.remove('lang-swap'));
  }, 260);
}

document.querySelectorAll('.lang-pill').forEach(p => {
  p.addEventListener('click', () => switchLang(p.dataset.lang));
});

const hamburger = document.querySelector('.hamburger');
const mobileMenu = document.querySelector('.mobile-menu');
hamburger.addEventListener('click', () => {
  hamburger.classList.toggle('active');
  mobileMenu.classList.toggle('open');
  document.body.style.overflow = mobileMenu.classList.contains('open') ? 'hidden' : '';
});
document.querySelectorAll('.mobile-link').forEach(link => {
  link.addEventListener('click', () => {
    hamburger.classList.remove('active');
    mobileMenu.classList.remove('open');
    document.body.style.overflow = '';
  });
});

let io;
function observeReveals() {
  if (!io) {
    io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.10, rootMargin: '0px 0px -40px 0px' });
  }
  document.querySelectorAll('.reveal:not(.in)').forEach(el => io.observe(el));
}

async function loadLiveData() {
  try {
    const carsRes = await fetch('/api/cars').then(r => r.ok ? r.json() : null);
    if (carsRes && carsRes.length > 0) {
      const cmsIds = new Set(carsRes.map(c => c.id));
      const localOnly = FLEET.filter(c => !cmsIds.has(c.id));
      FLEET = [...carsRes, ...localOnly];
    }
  } catch {}
}

async function init() {
  await loadLiveData();
  const carId = new URLSearchParams(window.location.search).get('id');
  const car = FLEET.find(c => c.id === carId);
  if (car) {
    renderDetail(car);
  } else {
    document.getElementById('detail-loading').classList.add('hidden');
    document.getElementById('detail-404').classList.remove('hidden');
  }
  observeReveals();
}

document.addEventListener('keydown', e => {
  if (galleryImages.length <= 1) return;
  if (e.key === 'ArrowLeft' && galleryIndex > 0) goToSlide(galleryIndex - 1);
  if (e.key === 'ArrowRight' && galleryIndex < galleryImages.length - 1) goToSlide(galleryIndex + 1);
});

init();
</script>
