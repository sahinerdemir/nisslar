function applySiteInfo(content) {
  if (!content?.site) return;
  const s = content.site;
  if (s.email) {
    const el = document.getElementById('footer-email');
    if (el) { el.href = 'mailto:' + s.email; el.textContent = s.email; }
  }
  if (s.phone) {
    const el = document.getElementById('footer-phone');
    if (el) { el.href = 'tel:' + s.phone.replace(/[^+\d]/g, ''); el.textContent = s.phone; }
  }
  if (s.socials) {
    const container = document.getElementById('footer-socials');
    if (container) container.innerHTML = s.socials.filter(sc => sc.url).map(sc => `
      <a href="${sc.url}" target="_blank" rel="noopener" aria-label="${sc.platform}" class="w-10 h-10 border border-white/10 hover:border-accent hover:text-accent transition flex items-center justify-center text-white/70">
        ${SOCIAL_ICONS[sc.platform] || ''}
      </a>
    `).join('');
  }
}

let io;
function observeReveals() {
  if (!io) {
    io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.10, rootMargin: '0px 0px -40px 0px' });
  }
  document.querySelectorAll('.reveal:not(.in)').forEach(el => io.observe(el));
}

async function loadLiveData() {
  try {
    const carsRes = await fetch('/api/cars').then(r => r.ok ? r.json() : null);
    if (carsRes && carsRes.length > 0) {
      const cmsIds = new Set(carsRes.map(c => c.id));
      const localOnly = FLEET.filter(c => !cmsIds.has(c.id));
      FLEET = [...carsRes, ...localOnly].filter(c => !c.deleted);
    }
  } catch {}
}

async function init() {
  applyI18nContent();
  await loadLiveData();
  
  // Fetch live site info to update email/phone/socials dynamically
  try {
    const contentRes = await fetch('/api/content').then(r => r.ok ? r.json() : null);
    if (contentRes) applySiteInfo(contentRes);
  } catch (err) {
    console.error('Failed to load site content', err);
  }

  applyI18nContent();

  const carId = new URLSearchParams(window.location.search).get('id');
  const car = FLEET.find(c => c.id === carId);
  if (!car) {
    document.getElementById('detail-loading').classList.add('hidden');
    document.getElementById('detail-404').classList.remove('hidden');
  }
  observeReveals();
}

document.addEventListener('keydown', e => {
  if (galleryImages.length <= 1) return;
  if (e.key === 'ArrowLeft' && galleryIndex > 0) goToSlide(galleryIndex - 1);
  if (e.key === 'ArrowRight' && galleryIndex < galleryImages.length - 1) goToSlide(galleryIndex + 1);
});

init();
</script>
